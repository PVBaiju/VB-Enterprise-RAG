# Google Gemini AI Configuration (Get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Google Model Name (default: gemini-1.5-flash-latest - free tier)
# Available models: gemini-1.5-flash-latest, gemini-1.5-pro, gemini-pro, etc.
GOOGLE_MODEL_NAME=gemini-1.5-flash-latest
